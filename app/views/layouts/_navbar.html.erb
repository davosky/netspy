<nav class="navbar navbar-expand-lg bg-primary sticky-top">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
      <%= image_tag "navbar/navbar-logo.svg", alt: t("app.name"), height: 28 %>
      <span><%= t("app.name") %></span>
    <% end %>

    <% if user_signed_in? %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
              aria-controls="navbarMenu" aria-expanded="false" aria-label="<%= t("layouts.navbar.toggle") %>">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navbarMenu">
        <ul class="navbar-nav">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarUserMenu" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
              <%= current_user.display_name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarUserMenu">
              <% if current_user.admin? %>
                <li><%= link_to t("layouts.navbar.administrate"), admin_root_path, class: "dropdown-item" %></li>
              <% end %>
              <li><%= link_to t("layouts.navbar.credits"), credits_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to t("layouts.navbar.logout"), destroy_user_session_path, method: :delete,
                      class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</nav>
