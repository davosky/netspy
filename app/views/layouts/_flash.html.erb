<% flash.each do |type, message| %>
  <div class="mt-3 alert alert-<%= flash_bootstrap_class(type) %> alert-dismissible fade show" role="alert" data-controller="flash">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t("app.close") %>"></button>
  </div>
<% end %>
