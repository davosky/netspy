<%# Live progress of a scan. `run` is a LanscanRun. While the scan runs it shows
    the bar; once finished only the summary line is left. %>
<div class="card shadow-sm mt-3"
     data-controller="lanscan-progress"
     data-lanscan-progress-url-value="<%= lanscan_run_path(run, format: :json) %>"
     data-lanscan-progress-done-template-value="<%= t("lanscans.progress.completed", duration: "%{duration}", hosts: "%{hosts}") %>"
     data-lanscan-progress-fail-text-value="<%= t("lanscans.progress.failed") %>">
  <div class="card-body p-4">
    <div data-lanscan-progress-target="running" <%= "hidden" if run.finished? %>>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-semibold">
          <i class="bi bi-activity me-2"></i><%= t("lanscans.progress.running", target: run.target) %>
        </span>
        <span class="text-body-secondary small">
          <span data-lanscan-progress-target="percent"><%= run.live_progress[:percent] %>%</span>
          ·
          <span data-lanscan-progress-target="elapsed"><%= human_duration(run.elapsed_seconds) %></span>
        </span>
      </div>

      <div class="progress" role="progressbar" aria-label="<%= t("lanscans.progress.running", target: run.target) %>"
           aria-valuemin="0" aria-valuemax="100" style="height: 1.25rem;">
        <div class="progress-bar progress-bar-striped progress-bar-animated"
             data-lanscan-progress-target="bar"
             style="width: <%= run.live_progress[:percent] %>%;"></div>
      </div>
    </div>

    <p class="mb-0 fw-semibold" data-lanscan-progress-target="status" <%= "hidden" unless run.finished? %>>
      <% if run.status == "completed" %>
        <%= t("lanscans.progress.completed", duration: human_duration(run.elapsed_seconds), hosts: run.hosts_found) %>
      <% elsif run.status == "failed" %>
        <%= run.error_message.presence || t("lanscans.progress.failed") %>
      <% end %>
    </p>
  </div>
</div>
