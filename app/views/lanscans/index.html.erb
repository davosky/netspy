<% content_for :title, t("lanscans.index.title") %>
<h1 class="h3 mb-4"><i class="bi bi-radar me-2"></i><%= t("lanscans.index.title") %></h1>
<% if policy(Lanscan).run? %>
  <div class="mb-4">
    <%= render "form", defaults: @lanscan_defaults %>
    <%= render "progress", run: @active_run if @active_run %>
  </div>
<% end %>
<h2 class="h5 mb-3"><%= t("lanscans.index.results") %></h2>
<% if @runs.empty? %>
  <p class="text-body-secondary"><%= t("lanscans.index.empty") %></p>
<% else %>
  <% @runs.each do |scanned_at, rows| %>
    <div class="card shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-clock-history me-2"></i><%= l(scanned_at, format: :long) %></span>
        <span class="text-body-secondary"><%= rows.first.target %> · <%= t("lanscans.index.hosts_count", count: rows.size) %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead>
            <tr>
              <th><%= Lanscan.human_attribute_name(:ip_address) %></th>
              <th><%= Lanscan.human_attribute_name(:mac_address) %></th>
              <th><%= Lanscan.human_attribute_name(:open_ports) %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |lanscan| %>
              <tr>
                <td>
                  <code class="fw-bold text-info">
                    <%= lanscan.ip_address %>
                  </code>
                </td>
                <td>
                  <code class="fw-bold text-success">
                    <%= lanscan.mac_address.presence || "—" %>
                  </code>
                </td>
                <td>
                  <% lanscan.open_ports_list.each do |port| %>
                    <code class="fw-bold text-warning">
                      <%= port %>
                    </code>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
