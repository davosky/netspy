<% content_for :title, "#{t("lanscans.show.title")} · #{@lanscan.ip_address}" %>

<%= link_to lanscans_path, class: "btn btn-link px-0 mb-3" do %>
  <i class="bi bi-arrow-left me-1"></i><%= t("lanscans.show.back") %>
<% end %>

<div class="card shadow-sm">
  <div class="card-body p-4">
    <h1 class="h4 mb-4"><i class="bi bi-hdd-network me-2"></i><%= @lanscan.ip_address %></h1>
    <dl class="row mb-0">
      <dt class="col-sm-3"><%= Lanscan.human_attribute_name(:target) %></dt>
      <dd class="col-sm-9"><code><%= @lanscan.target %></code></dd>

      <dt class="col-sm-3"><%= Lanscan.human_attribute_name(:mac_address) %></dt>
      <dd class="col-sm-9"><%= @lanscan.mac_address.presence || "—" %></dd>

      <dt class="col-sm-3"><%= Lanscan.human_attribute_name(:scanned_at) %></dt>
      <dd class="col-sm-9"><%= l(@lanscan.scanned_at, format: :long) %></dd>

      <dt class="col-sm-3"><%= Lanscan.human_attribute_name(:open_ports) %></dt>
      <dd class="col-sm-9">
        <% if @lanscan.open_ports_list.any? %>
          <% @lanscan.open_ports_list.each do |port| %>
            <span class="badge text-bg-secondary me-1"><%= port %></span>
          <% end %>
        <% else %>
          —
        <% end %>
      </dd>
    </dl>
  </div>
</div>
