<div class="row me-5 ms-5 mt-5">
  <div class="col-6 p-3">
    <div class="text-center">
      <%= image_tag("main/main-logo.svg", class: "img-responsive", size: "256x256", alt: "main-logo") %>
    </div>
    <hr class="text-white m-3"/>
    <dl class="row m-3">
      <dt class="col-sm-4"><%= t("pages.credits.application") %></dt>
      <dd class="col-sm-8"><%= t("app.name") %></dd>
      <dt class="col-sm-4"><%= t("pages.credits.purpose") %></dt>
      <dd class="col-sm-8"><%= t("pages.index.description") %></dd>
      <dt class="col-sm-4"><%= t("pages.credits.stack") %></dt>
      <dd class="col-sm-8">Ruby on Rails, Hotwire, Bootstrap, PostgreSQL</dd>
    </dl>
  </div>
  <div class="col-6 p-3">
    <div class="text-center">
      <%= image_tag("main/main-davosky-logo.svg", class: "img-responsive", size: "256x256", alt: "davosky-main-logo") %>
    </div>
    <hr class="text-white m-3"/>
    <dl class="row m-3">
      <dt class="col-sm-4"><%= t("pages.credits.author") %></dt>
      <dd class="col-sm-8">Davo Davosky</dd>
      <dt class="col-sm-4">Repository Progetto</dt>
      <dd class="col-sm-8">
        <%= link_to("https://github.com/davosky/netspy", target: "_blank", rel: "noopener") do %>
          <i class="bi bi-folder-fill me-3"></i>NetSpy Repo
        <% end %>
      </dd>
    </dl>
    <span class="m-3 p-3">
      <%= image_tag("main/by-davo-main-logo.svg", class: "img-responsive", alt: "by-davo-main-logo") %>
    </span>
  </div>
</div>
